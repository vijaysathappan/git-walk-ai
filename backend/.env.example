# Copy this file to backend/.env. Never commit the real values.
APP_ENV=development
APP_URL=https://localhost:3000
API_BASE_URL=http://localhost:8000
OFFICE_ADDIN_URL=https://localhost:3000
DATABASE_URL=sqlite:///./queue_board.db
CORS_ORIGINS=https://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-account@gmail.com

AUTH_SECRET=replace-with-a-long-random-value
AUTH_REQUIRED=true
DEV_SHOW_OTP=false
SESSION_HOURS=24
OTP_MINUTES=10
OTP_REQUEST_COOLDOWN_SECONDS=12
OTP_REQUESTS_PER_HOUR=25

# Bounded workbook processing
MAX_UPLOAD_BYTES=26214400
MAX_XLSX_ENTRIES=2500
MAX_XLSX_UNCOMPRESSED_BYTES=262144000
MAX_WORKBOOK_SHEETS=100
MAX_WORKBOOK_ROWS=250000
MAX_WORKBOOK_COLUMNS=1000
UPLOAD_PROCESSING_TIMEOUT_SECONDS=60
TEMP_FILE_MAX_AGE_HOURS=24
LOG_LEVEL=INFO

# Repository permanent-deletion pipeline (services/repository_purge_service.py).
# An owner's manual delete always runs the full export->email->notify->
# hard-delete pipeline; these only govern the automatic daily sweep that
# also purges already-soft-deleted and long-inactive repositories.
REPOSITORY_PURGE_SWEEP_ENABLED=true
REPOSITORY_PURGE_INACTIVITY_DAYS=30
REPOSITORY_PURGE_SWEEP_INTERVAL_SECONDS=86400
# Leave blank to default to backend/repository_exports/
REPOSITORY_PURGE_EXPORT_DIR=
REPOSITORY_PURGE_MAX_PHYSICAL_ROWS_PER_TABLE=20000

# Stage 1 semantic ledger. Use local for zero-dependency development.
STORAGE_ENGINE=semantic_object_v1
OBJECT_STORE_PROVIDER=local
OBJECT_STORE_PATH=./object_store
OBJECT_STORE_BUCKET=gitwalk-objects
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_COMPRESSION=zstd
OBJECT_HASH_ALGORITHM=sha256
SEMANTIC_BLOCK_ROWS=256
IDEMPOTENCY_TTL_HOURS=24
REDIS_URL=redis://localhost:6379/0

# Stage 2.1 EUC ingestion and inventory safety limits
EUC_ANALYSIS_VERSION=2.1.0
EUC_MAX_FILE_SIZE=52428800
EUC_MAX_DECOMPRESSED_SIZE=524288000
EUC_MAX_ZIP_ENTRIES=5000
EUC_MAX_XML_SIZE=104857600
EUC_MAX_CELLS=5000000
EUC_MAX_FORMULAS=1000000
EUC_ANALYSIS_TIMEOUT_SECONDS=300

# Stage 2.2 deterministic formula dependency graph
DEPENDENCY_ENGINE_VERSION=2.2.0
DEPENDENCY_RANGE_EXPANSION_LIMIT=1000
MAX_DEPENDENCY_DEPTH=20
MAX_GRAPH_RESPONSE_NODES=5000
DEPENDENCY_SQLITE_EDGE_LIMIT=100000
DEPENDENCY_ANALYSIS_TIMEOUT_SECONDS=300
INTELLIGENCE_ENGINE_VERSION=2.3.0
INTELLIGENCE_RULESET_VERSION=ruleset@2.3.0
INTELLIGENCE_DEFAULT_PROFILE=DEFAULT
INTELLIGENCE_ANALYSIS_TIMEOUT_SECONDS=300
INTELLIGENCE_CRITICALITY_THRESHOLD=70
INTELLIGENCE_FINDING_LIMIT=5000
MIGRATION_ENGINE_VERSION=2.4.0
MIGRATION_RULESET_VERSION=migration-rules@2.4.0
MIGRATION_ANALYSIS_TIMEOUT_SECONDS=300
MIGRATION_UNIT_LIMIT=100000
MIGRATION_REPLAY_COMMIT_LIMIT=50
MIGRATION_ABSOLUTE_TOLERANCE=0.000001
MIGRATION_RELATIVE_TOLERANCE=0.000001
AIR_ENGINE_VERSION=2.5.0
AIR_GENERATOR_VERSION=2.5.0
AIR_DEFAULT_TARGET_PROFILE=WEB_POSTGRES_FASTAPI_REACT
AIR_AUTO_GENERATE_CONFIDENCE=0.95
AIR_REVIEW_CONFIDENCE=0.80

# Optional AI gateway
# Git Walk only permits free-tier NVIDIA OpenRouter models (see
# app/ai/catalog.py::is_free_nvidia_model_id / NVIDIA_FREE_MODEL_DEFAULTS) —
# a non-NVIDIA or non-":free" model here is silently replaced by
# NVIDIA_FREE_MODEL_DEFAULTS[0] at startup (app/config.py), so set a real
# one to get what you configured. OPENROUTER_MODELS is a comma-separated
# allowlist (non-free entries are dropped); OPENROUTER_MODEL is added to it
# automatically if not already present.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-nano-9b-v2:free
