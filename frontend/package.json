{
  "name": "excel-sqlite-livesync-frontend",
  "version": "1.0.0",
  "description": "React frontend for ExcelSQLiteLiveSync — file upload app + Office.js embedded taskpane",
  "private": true,
  "scripts": {
    "setup:cert": "office-addin-dev-certs install --days 365",
    "verify:cert": "office-addin-dev-certs verify",
    "prestart": "office-addin-dev-settings register public/manifest.xml",
    "start": "node scripts/start-dev-server.js",
    "stop": "office-addin-dev-settings unregister public/manifest.xml",
    "dev-server": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-dev-settings": "^3.1.2",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions"
  ]
}
